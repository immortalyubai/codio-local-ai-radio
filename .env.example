# Local AI Radio / Codio
# Copy this file to .env and fill only the keys you want to use.

# API server
HOST=0.0.0.0
PORT=4000

# Frontend -> API base URL
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Optional LLM provider for Codio chat and host intro copy
RADIO_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional OpenAI-compatible fallback, if you wire it later
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional MiniMax TTS for Codio host voice
RADIO_TTS_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_VOICE_ID=Chinese (Mandarin)_Warm-HeartedAunt
MINIMAX_VOICE_SPEED=1
MINIMAX_VOICE_PITCH=0
MINIMAX_VOICE_VOLUME=1

# Optional NetEaseCloudMusicApi helper service
NETEASE_API_BASE=http://localhost:3001
